# Copy to .env and edit. NEVER commit the real .env file.
APP_ENV=development            # development | production | testing
SECRET_KEY=                    # REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"

DB_HOST=localhost
DB_PORT=3306
DB_USER=sentinel_app
DB_PASSWORD=
DB_NAME=sentinel_hr

# Minimum number of feedback items before a group's sentiment breakdown is shown to HR
MIN_GROUP_SIZE=5
# Set to true ONLY when serving over HTTPS
SESSION_COOKIE_SECURE=false
ALLOWED_EMAIL_DOMAIN=          # optional, e.g. example.com
